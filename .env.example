# Copy this to .env and fill in values before running docker compose

POSTGRES_DB=gantry
POSTGRES_USER=gantry
POSTGRES_PASSWORD=changeme

# Port to expose the app on the host (default: 8080)
APP_PORT=8080

# Shared secret required as a Bearer token to call the MCP server at /mcp.
# Generate one yourself, e.g.: openssl rand -hex 32
MCP_BEARER_TOKEN=changeme
